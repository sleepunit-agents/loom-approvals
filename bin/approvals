#!/usr/bin/env python3
"""approvals: an agent's body hits a permission wall and asks; the owner says yes or no on loom's page.

    approvals request --kind KIND --target TARGET --ask "…" --why "…" --if-yes "…" --if-no "…"
                      [--details "…"] [--what "…"] [--minutes N]
                                --ask is the one plain question the owner reads (≤140, no ids, hashes, round
                                numbers or lane words); --why one line; --if-yes/--if-no what happens either way;
                                --details longer text for the sheet. --what alone (the old form) still works, and
                                its card says "(no plain question given)" so the caller gets fixed.
    approvals check ID          pending | allowed | denied | used | expired
    approvals check ID --json   for the agent that asked: its state and the exact kind and target to spend it on
    approvals use ID --kind KIND --target TARGET
                                spend an allowed approval: once, for exactly that kind and target
    approvals withdraw ID --as AGENT_JSON
                                loom's machine only: a piece takes back its own pending card (vouch-wake, …)
    approvals list              the recent ones (the owner's view, on loom's machine)

Standing rules (loom docs/specs/changes.md): the owner's lasting answer for merging, per repo pattern or project.
    approvals rule merge TARGET do | tell | ask, and for ask the newest merge approval's state for TARGET
                                (TARGET is <forge>:<locator>#<n>@<head>, e.g. github:acme/app#12@<40 hex>)
    approvals tell --kind merge --target TARGET --what "…"
                                after merging under a do or tell rule: an FYI on loom's Inbox
    approvals grant --kind merge --target TARGET --for AGENT --by MEMBER [--person SLUG] [--deny]
                                loom's machine only (the Changes piece's Yes and Not yet): the owner's answer
                                before, or instead of, the agent's request

loom's approvals piece (loom-approvals): bodies create and check requests and spend
an allowed one; they never approve. Only the owner does, with Allow or Deny on loom's
Home (a card under "Your call"). An approval is a single-use receipt for one action:
KIND (what wall: a GitHub write guard, a relay, …) and TARGET (exactly what it's for:
owner/repo:account, alpha->beta, …). It's spent by the call it allowed, and lasts
MINUTES (60, 8 h at most) once allowed.

The words a body gives (--what, --why) are its own: shown to the owner, never what
decides. A body may be steered, so nothing here grants by itself.

loom's piece verbs: `ui --json`, `ui page --json`, `ui act --json`, `api --json`.
Over the piece API (a house, any box) the caller is loom's; run here, it's loom's machine.

Settings (environment; a managed piece gets them from loom):
  APPROVALS_DIR          where the store lives (default: <piece home>/data, else
                         ~/.local/state/loom-approvals)
  APPROVALS_LOCAL_AGENT  the agent a request made on loom's machine itself is from
                         (default: agent)
  APPROVALS_KINDS        extra words for kinds, as JSON: {"github-write": "A GitHub write"}
  APPROVALS_SEED_RULES   the standing rules to start with, as JSON (written once, when there are none yet):
                         [{"kind": "merge", "scope": "github:acme/*", "tier": "do"}]
  APPROVALS_PROJECTS     the command that lists project cards, for project:<slug> rules
                         (default: loom project list --json)
  APPROVALS_PRINCIPAL    the runtime's command for on whose behalf a body acts (default: loom runtime principal):
                         `<it> --verify` checks a statement on stdin
  APPROVALS_LOCAL_PRINCIPAL  who a call on loom's machine itself acts for, with no statement: owner (default) or unknown

On whose behalf (t-1943): the owner's standing rules and his yes cover work done for him. A body acting for anyone
else (a person in Slack or Discord, a body they steer) gets the grants he set for that person, or asks; a card names
who it's for, and an approval asked for one person is spent only for them. Who a body acts for is the runtime's word
(a statement it signs, `--principal`, which a house's piece-call adds), never the body's: none means someone loom
can't name, never the owner.
"""
import argparse
import fcntl
import json
import os
import re
import secrets
import shlex
import subprocess
import sys
import unicodedata
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path


def piece_home():
    """This piece's home under loom (`$LOOM_HOME/pieces/approvals`): loom says so when it runs us
    (LOOM_PIECE_HOME); run directly, by the bin loom linked, it's found from where this file lives."""
    h = os.environ.get("LOOM_PIECE_HOME")
    if h:
        return Path(h)
    here = Path(__file__).resolve().parent
    for d in [here, *here.parents][:8]:
        if (d / "piece.json").is_file() and (d / "versions").is_dir():
            return d
    return None


PIECE_HOME = piece_home()


def _owner_settings():
    try:
        d = json.loads((PIECE_HOME / "settings.json").read_text()) if PIECE_HOME else {}
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


_SETTINGS = _owner_settings()


def setting(name, default=""):
    """A setting: the environment (loom puts the owner's settings there), else the owner's
    settings.json in the piece home (a direct run), else the default."""
    v = os.environ.get(name)
    if v in (None, ""):
        v = _SETTINGS.get(name)
    return v if isinstance(v, str) and v != "" else default


STATE = Path(setting("APPROVALS_DIR") or
             (PIECE_HOME / "data" if PIECE_HOME else Path.home() / ".local" / "state" / "loom-approvals")).expanduser()
LOCAL_AGENT = setting("APPROVALS_LOCAL_AGENT", "agent")
KIND = re.compile(r"^[a-z][a-z0-9-]{0,39}$")
ID = re.compile(r"^a-[0-9a-f]{8}$")
TARGET_MAX, WORDS_MAX = 200, 300
DEFAULT_MIN, MAX_MIN = 60, 8 * 60
KEEP = 300
GRANT_MIN = 24 * 60          # an owner's grant (approvals grant) lasts a day: it's bound to one head anyway
NOTICES_KEEP = 50
# A merge approval's target: one change at one head (loom docs/specs/changes.md, "Ids").
FORGE = r"[a-z][a-z0-9-]{0,23}"
# A merge target is literal: a body chooses it, and Always turns its repo into a rule, so nothing in it may read as a
# pattern. Segments are [A-Za-z0-9._-]; two to four of them (github owner/repo, forgejo host/owner/repo, azure
# org/project/repo), 120 characters at most.
SEGMENT = r"[A-Za-z0-9._-]+"
LITERAL_LOCATOR = rf"{SEGMENT}(?:/{SEGMENT}){{1,3}}"
MERGE_TARGET = re.compile(rf"({FORGE}):({LITERAL_LOCATOR})#([1-9][0-9]{{0,9}})@([0-9a-f]{{40}})")
LOCATOR_MAX = 120
LOCATOR = r"[\x21-\x22\x24-\x3f\x41-\x7e]{1,120}"     # a rule's pattern (the owner's): printable ASCII but space, # and @
PATTERN_CHARS = set("*?[]{}!\\")
TIERS = ("do", "tell", "ask")
RULE_KINDS = ("merge",)
RULES_MAX = 100
GRANTS_MAX = 100
PERSON = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")
# A principal: on whose behalf an action is (t-1943). "owner": the owner's own work; a person's slug; "?": someone loom
# can't name (no statement, several people, a relay). Only "owner" reads the standing rules.
OWNER, UNKNOWN = "owner", "?"


def now():
    return datetime.now(timezone.utc)


def iso(t):
    return t.strftime("%Y-%m-%dT%H:%M:%SZ")


# Kinds only a piece on loom's machine files, for the body it acts for (--as): never a body over the API, so a body
# can't put its own words on a card the owner reads as the piece's.
PIECE_KINDS = {"local-wake", "vouch-wake", "principal-reset", "box-administration"}

# Access to one of loom's pieces for an agent (loom docs/specs/agent-runtime.md, "6. Permissions"; t-1970): a body asks
# with --kind grant --target <piece>:<agent>[:<path>,<path>], and the household owner's Allow is applied by the runtime
# (loom's grants authority) at once, as the owner: Mark may use Tasks from then on. So it isn't spent by a body: only the
# runtime on loom's machine spends it (--as the agent that asked), in the same step that applies it. And only the
# household owner answers it: an agent's owner (a member) can't give an agent a piece of the household's.
GRANT_KIND = "grant"
GRANT_NAME = r"[a-z][a-z0-9-]{0,39}"

# Owner-only actions that used to need him at a terminal on loom's machine (t-1975, Jonathan 2026-11-08: "It needs to
# have the site ask me"): his Allow on loom's page is the owner proof, and the piece that owns the state applies it at
# once, as him. Like a grant: filed by that piece (PIECE_KINDS, never a body's words), answered only by the household
# owner, spent only by that piece (PIECE_SPENT), in the step that applies it.
#   vouch-wake       <agent>:<w-id>[,<w-id>…]  (the clock): these pending wakes, set before their body could say whom
#                    it worked for, are the owner's work, and fire as his. The ids sorted, each once: one set, one text.
#   principal-reset  <agent>:<cv-id>  (the runtime): this conversation is the owner's from now on (`loom runtime
#                    principal --reset`): what it heard before is set aside, and its session dropped.
VOUCH_KIND = "vouch-wake"
RESET_KIND = "principal-reset"
# At most 12 wakes on one card: each listed with its id, when it fires and what it's for, all within DETAILS_MAX (1000)
# and a read the owner takes in at a glance. A clock with more files the first 12 and the rest once that's answered.
VOUCH_MAX = 12
VOUCH_TARGET = re.compile(rf"({GRANT_NAME}):(w-[0-9a-f]{{6}}(?:,w-[0-9a-f]{{6}}){{0,{VOUCH_MAX - 1}}})")
RESET_TARGET = re.compile(rf"({GRANT_NAME}):(cv-[0-9a-f]{{12}})")
OWNER_APPLIED = {GRANT_KIND, VOUCH_KIND, RESET_KIND}
PIECE_SPENT = set(OWNER_APPLIED)


def vouch_of(target):
    """A vouch-wake target as {agent, ids}, or None: art:w-0f0cfb,w-3c68fa. Its ids sorted and each once, so a set of
    wakes has exactly one target, and the approval is spent for exactly that set (never one more)."""
    m = VOUCH_TARGET.fullmatch(str(target or ""))
    if not m:
        return None
    ids = m.group(2).split(",")
    return {"agent": m.group(1), "ids": ids} if ids == sorted(set(ids)) else None


def reset_of(target):
    """A principal-reset target as {agent, conversation}, or None: art:cv-0123456789ab."""
    m = RESET_TARGET.fullmatch(str(target or ""))
    return {"agent": m.group(1), "conversation": m.group(2)} if m else None


def owner_words(a):
    """An owner-applied card's headline, in the piece's words from its target (never the body's): None for any other."""
    k, t = a.get("kind"), a.get("target")
    if k == GRANT_KIND:
        return grant_words(t)
    if k == VOUCH_KIND and vouch_of(t):
        n = len(vouch_of(t)["ids"])
        return "Count this scheduled job as your work?" if n == 1 else f"Count these {n} scheduled jobs as your work?"
    if k == RESET_KIND and reset_of(t):
        return "Count this conversation as your work from now on?"
    return None


def owner_lines(a):
    """An owner-applied card's "If you allow" and "If you deny", the piece's words; {} for any other kind."""
    k, t = a.get("kind"), a.get("target")
    if k == GRANT_KIND:
        return grant_lines(a)
    if k == VOUCH_KIND and vouch_of(t):
        v = vouch_of(t)
        one = len(v["ids"]) == 1
        return {"if_yes": f"{'It fires' if one else 'They fire'} as your work, in {name_of(v['agent'])}'s own house, with your "
                          f"standing permissions. Any that fired already stay as they were.",
                "if_no": f"Nothing changes: {'it fires' if one else 'they fire'} as no one's, and ask{'s' if one else ''} you "
                         "for anything that needs you."}
    if k == RESET_KIND and reset_of(t):
        r = reset_of(t)
        return {"if_yes": f"{name_of(r['agent'])}'s work there counts as yours from now on, with your standing permissions. "
                          "It starts afresh: what it heard before is set aside.",
                "if_no": "Nothing changes: it stays no one's, and asks you for anything that needs you."}
    return {}
GRANT_PATH = r"(?:\*|[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*(?:/\*)?)"
GRANT_TARGET = re.compile(rf"({GRANT_NAME}):({GRANT_NAME})(?::({GRANT_PATH}(?:,{GRANT_PATH}){{0,9}}))?")


def grant_of(target):
    """A grant target as {piece, agent, paths}, or None: tasks:mark, tasks:mark:run, tasks:mark:people/*,run."""
    m = GRANT_TARGET.fullmatch(str(target or ""))
    if not m:
        return None
    paths = m.group(3).split(",") if m.group(3) else ["*"]
    if any(x in (".", "..") for p in paths for x in p.split("/")):
        return None
    return {"piece": m.group(1), "agent": m.group(2), "paths": paths}


def grant_words(target):
    """What a grant's Allow gives, in the piece's words (never the body's): "Give Mark access to Tasks?"."""
    g = grant_of(target)
    if not g:
        return None
    some = "" if "*" in g["paths"] else f", for {', '.join(g['paths'])}"
    return f"Give {name_of(g['agent'])} access to {name_of(g['piece'])}{some}?"


FINE_MAX = 400   # loom's cap on an ask's fine print (vocab.ts plainOf): past it the whole manifest is refused


def grant_lines(a):
    """A grant's "If you allow" and "If you deny", the piece's words from its target; {} for any other kind."""
    if a.get("kind") != GRANT_KIND or not grant_of(a.get("target")):
        return {}
    return {"if_yes": grant_if_yes(a["target"]), "if_no": grant_if_no(a["target"])}


def grant_if_yes(target):
    """What Allow does, in the piece's words, beside Allow on the card: never the body's."""
    g = grant_of(target)
    some = "all of it" if "*" in g["paths"] else ", ".join(g["paths"])
    return f"{name_of(g['agent'])} can use {name_of(g['piece'])} ({some}) from now on, added to whatever else it has."


def grant_if_no(target):
    """What Deny does, in the piece's words."""
    g = grant_of(target)
    return f"Nothing changes: {name_of(g['agent'])} can't use any more of {name_of(g['piece'])} than it can now."


def exact_target(target):
    """A target is approved and spent as exactly the text the owner read, compared raw. It is an identifier (a repo, a
    wake's agent:hash, a relay's agent->agent), so it is printable ASCII, single spaces between words: nothing that
    could look like another target on the card (no homoglyphs, combining marks, control or invisible characters).
    loom draws a card's text as text, never markup, so `<` and `>` are fine."""
    t = str(target or "")
    if len(t) > TARGET_MAX or not re.fullmatch(r"[\x21-\x7e]+( [\x21-\x7e]+)*", t):
        raise ValueError(f"--target is printable ASCII, at most {TARGET_MAX} characters, single spaces between words: "
                         "it's matched exactly as shown")
    return t


def plain(text, n):
    """One line with nothing that reads as markup or a second line: a body's words, as words."""
    t = unicodedata.normalize("NFKC", str(text or ""))
    t = "".join(" " if unicodedata.category(c)[0] in "CZ" or c in "<>[]{}" else c for c in t)
    return re.sub(r" +", " ", t).strip()[:n]


class Store:
    def __init__(self):
        STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(STATE, 0o700)  # mkdir's mode only applies to a directory it makes
        self.path, self.audit = STATE / "approvals.json", STATE / "audit.jsonl"

    def __enter__(self):
        self.lock = os.fdopen(os.open(STATE / "approvals.lock", os.O_CREAT | os.O_WRONLY, 0o600), "w")
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        try:
            self.d = json.loads(self.path.read_text())
        except (OSError, ValueError):
            self.d = {"v": 1, "approvals": {}}
        self._rules, self._grants = None, []
        return self

    def save(self):
        rows = sorted(self.d["approvals"].values(), key=lambda a: a["at"], reverse=True)
        # The owner's No to a vouch or a reset is kept past KEEP (t-1975): it's what stops him being asked again.
        kept = rows[:KEEP] + [a for a in rows[KEEP:] if a["kind"] in (VOUCH_KIND, RESET_KIND) and a["state"] == "denied"]
        self.d["approvals"] = {a["id"]: a for a in kept}
        self.write_json(self.path, self.d)

    def rules(self):
        """The standing rules (rules.json beside the store), under the same lock. Seeded once from
        APPROVALS_SEED_RULES when the file doesn't exist yet; never again, so a rule the owner removed stays removed.
        A file that can't be read, or whose rules aren't rules, answers no rules (so everything asks) and is marked
        broken, so no edit overwrites it with that emptiness."""
        if self._rules is not None:
            return self._rules
        path = STATE / "rules.json"
        self.rules_broken = False
        self._grants = []
        try:
            doc = json.loads(path.read_text())
            rows = doc["rules"]
            if not isinstance(rows, list):
                raise TypeError("rules isn't a list")
            self._rules = [r for r in rows if well_formed(r)]
            if len(self._rules) != len(rows):
                self.rules_broken = True
            # The owner's grants for other people (t-1943), beside the rules: none yet is none.
            grants = doc.get("grants", [])
            if not isinstance(grants, list):
                raise TypeError("grants isn't a list")
            self._grants = [g for g in grants if well_formed_grant(g)]
            if len(self._grants) != len(grants):
                self.rules_broken = True
        except FileNotFoundError:
            self._rules = seed_rules()
            self.write_json(path, {"v": 1, "rules": self._rules, "grants": []})
        except (OSError, ValueError, KeyError, TypeError):
            self._rules, self._grants, self.rules_broken = [], [], True
        return self._rules

    def grants(self):
        """The owner's grants for other people (rules.json's "grants"), read with the rules. A file that can't be read
        has none, so a body acting for anyone but the owner asks (fails closed)."""
        self.rules()
        return self._grants

    def replace_rules(self, rules, grants=None):
        self.rules()        # the grants are read with the rules: an edit of one never writes the other away
        if self.rules_broken:
            raise ValueError("rules.json can't be read as it is; fix or remove it on loom's machine before changing a rule")
        self._rules = rules
        if grants is not None:
            self._grants = grants
        self.write_json(STATE / "rules.json", {"v": 1, "rules": self._rules, "grants": self._grants})

    @staticmethod
    def write_json(path, obj):
        tmp = path.with_suffix(f".{os.getpid()}.tmp")
        with os.fdopen(os.open(tmp, os.O_CREAT | os.O_WRONLY | os.O_TRUNC, 0o600), "w") as f:
            f.write(json.dumps(obj, indent=1) + "\n")
        tmp.replace(path)

    def log(self, event, a, **extra):
        with os.fdopen(os.open(self.audit, os.O_CREAT | os.O_WRONLY | os.O_APPEND, 0o600), "a") as f:
            f.write(json.dumps({"at": iso(now()), "event": event, "id": a["id"], "kind": a["kind"],
                                "target": a["target"], "who": a["who"], **extra}) + "\n")

    def __exit__(self, *exc):
        self.lock.close()


def newest_decision(rows, kind, target, agent):
    """The owner's newest answer for this kind, target and agent: the approval decided last, or None."""
    done = [a for a in rows if a["kind"] == kind and a["target"] == target and a["who"].get("agent") == agent and a.get("decided")]
    return max(done, key=lambda a: a["decided"], default=None)


def deny_siblings(s, kind, target, agent, keep, by=None):
    """A deny stops every earlier yes: each unspent pending or allowed approval for the same kind, target and agent
    is denied too, and logged."""
    for a in s.d["approvals"].values():
        if a["id"] != keep and a["kind"] == kind and a["target"] == target and a["who"].get("agent") == agent \
                and state_of(a) in ("pending", "allowed"):
            a["state"], a["decided"], a["superseded_by"] = "denied", iso(now()), keep
            a.pop("expires", None)
            if by:
                a["by"] = by
            s.log("deny-superseded", a, by_deny=keep)


def state_of(a, t=None):
    t = t or now()
    if a["state"] == "allowed" and a.get("expires") and datetime.strptime(a["expires"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc) <= t:
        return "expired"
    return a["state"]


def who_of(caller):
    """Who's asking: a house (agent and house), another agent's body, or loom's machine itself."""
    if not caller:
        return {"agent": LOCAL_AGENT, "where": "loom's machine"}
    if caller.get("kind") == "agent" and isinstance(caller.get("agent"), str):
        where = caller.get("house") or "a body"
        if caller.get("service"):
            where = f"{where} ({caller['service']})"
        return {"agent": caller["agent"], "where": where}
    raise PermissionError("only an agent's bodies ask (the owner answers on the page)")


def service_of(who):
    """The service a house serves (a chat or bridge house: "h-12 (discord-bodies)"), or None for a plain one."""
    m = re.search(r"\(([^()]*)\)$", who.get("where", ""))
    return m.group(1) if m else None


def may_spend(asked, who):
    """Whether `who` may spend (or re-ask, or read) what `asked` asked for. The owner (2026-11-07): "if I've given
    permission it doesn't matter from where or to which body", for the agent's own bodies: a parked body's continuation
    runs in a later house, often a plain one when a service's house asked. A service's house is one that people other
    than the owner can steer (a chat or bridge house serving them), so it spends only what its own service asked for.
    Plain houses, a body outside a house and loom's machine match on the agent alone. The action itself is pinned by
    kind and exact target, spent once, within its expiry, and a later deny overrules it."""
    if asked.get("agent") != who.get("agent"):
        return False
    svc = service_of(who)
    return svc is None or svc == service_of(asked)


def verify_statement(statement):
    """The runtime's word on a statement (`loom runtime principal --verify`): {agent, for, owner, people} or None."""
    cmd = setting("APPROVALS_PRINCIPAL", "loom runtime principal")
    try:
        out = subprocess.run([*shlex.split(cmd), "--verify"], input=statement, capture_output=True, text=True, timeout=10)
        r = json.loads(out.stdout or "{}")
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    return r if isinstance(r, dict) and r.get("ok") is True and out.returncode == 0 else None


def principal_of(who, statement=None, local=False):
    """On whose behalf `who` acts: {"for": "owner" | slug | "?", "people": [slugs]}. From the runtime's signed statement
    for this agent, else (a call on loom's machine itself, `local`) APPROVALS_LOCAL_PRINCIPAL, else "?". A statement
    for another agent, or one that doesn't verify, is "?": never the owner by default."""
    if statement:
        v = verify_statement(statement)
        if not v or v.get("agent") != who.get("agent"):
            return {"for": UNKNOWN, "people": []}
        people = [p for p in (v.get("people") or []) if isinstance(p, str) and PERSON.fullmatch(p)][:20]
        if v.get("owner") is True:
            return {"for": OWNER, "people": []}
        f = v.get("for")
        # A person whose slug is "owner" is a person, not the owner: unknown here, since the words are the same.
        return {"for": f if isinstance(f, str) and PERSON.fullmatch(f) and f != OWNER else UNKNOWN, "people": people}
    if local and not LOCAL_BODY:
        return {"for": OWNER if setting("APPROVALS_LOCAL_PRINCIPAL", OWNER) == OWNER else UNKNOWN, "people": []}
    return {"for": UNKNOWN, "people": []}


# A body the runtime runs on loom's machine (a local wake) is in a conversation, like a house's: it acts for whom that
# conversation says, never for the owner by being here. main() fetches its statement; without one it's unknown.
LOCAL_BODY = False


def fetch_statement(conversation):
    """This body's statement from the runtime (`loom runtime principal --conversation cv`), or None. In a house that's
    the house's own `loom-runtime` (loom-box installs it there): APPROVALS_PRINCIPAL is a setting of loom's machine."""
    cmd = "loom-runtime principal" if in_a_house() else setting("APPROVALS_PRINCIPAL", "loom runtime principal")
    try:
        out = subprocess.run([*shlex.split(cmd), "--conversation", conversation], capture_output=True, text=True,
                             timeout=30, stdin=subprocess.DEVNULL)
        r = json.loads(out.stdout or "{}")
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    st = r.get("statement") if isinstance(r, dict) and r.get("ok") is True else None
    # Opaque: the runtime's to read (--verify). One word, of a size a command line carries.
    return st if isinstance(st, str) and 0 < len(st) <= 1100 and not re.search(r"\s", st) else None


def for_of(a):
    """An approval's principal; one from before principals was asked as the owner's (they lasted 8 hours at most)."""
    f = a.get("for", OWNER)
    return f if f in (OWNER, UNKNOWN) or PERSON.fullmatch(str(f)) else UNKNOWN


def same_principal(a, p):
    """Whether approval `a` was asked for principal `p`: the same owner, person, or (someone loom can't name) the same
    people it named, so a card that read "for Loren and Dan" is never spent for Eve."""
    f = for_of(a)
    if f != p["for"]:
        return False
    return f != UNKNOWN or sorted(a.get("people") or []) == sorted(p.get("people") or [])


def person_name(slug):
    """A person's slug as a name: "loren" -> "Loren", "loren-smith" -> "Loren Smith"."""
    return " ".join(w[:1].upper() + w[1:] for w in str(slug).split("-") if w)


def for_words(a):
    """Who it's for, in words, or None for the owner's own: "Loren", "Loren and Dan", "someone loom can't name"."""
    f = for_of(a)
    if f == OWNER:
        return None
    if f != UNKNOWN:
        return person_name(f)[:40]
    people = [person_name(p)[:40] for p in a.get("people") or []]
    if len(people) > 3:
        return f"{', '.join(people[:2])} and {len(people) - 2} others"
    if len(people) > 1:
        return ", ".join(people[:-1]) + " and " + people[-1]
    return "someone loom can't name"


def principal_for_call(caller, who, statement=None, acting_for=False, on_behalf=None):
    """On whose behalf this call is. A piece on loom's machine acting for a body (--as) may say it (--on-behalf: the
    clock, whom the wake is for); otherwise the runtime's statement, or loom's machine's own setting, or unknown."""
    if acting_for and on_behalf:
        return {"for": on_behalf if on_behalf == OWNER or PERSON.fullmatch(on_behalf) else UNKNOWN, "people": []}
    return principal_of(who, statement, local=caller is None)


def principal_words(p):
    """A principal ({"for", "people"}) in words, as for_words says an approval's: "you" for the owner."""
    return for_words({"for": p["for"], "people": p.get("people") or []}) or "you"


DETAILS_MAX = 1000


CONVERSATION = re.compile(r"cv-[0-9a-f]{12}")


def request(caller, kind, target, what, why, minutes=None, acting_for=False, ask=None, if_yes=None, if_no=None, details=None,
            conversation=None, statement=None, on_behalf=None):
    who = who_of(caller)
    # On whose behalf (t-1943): kept on the card, which names them, and what it may be spent for.
    p = principal_for_call(caller, who, statement, acting_for, on_behalf)
    # The conversation the body says it asked from (loom docs/specs/comms.md, "Asks inline"): a Comms thread shows its
    # own pending approvals. It's the body's claim, not something loom vouches for: the caller loom authenticates is an
    # agent (and its house), never a conversation. So it decides nothing about the approval, and loom shows the ask in
    # a thread only when this approval's agent (who.agent, which loom did authenticate) is that thread's agent.
    if conversation and not CONVERSATION.fullmatch(conversation):
        raise ValueError("--conversation is a conversation id, cv- and 12 hex")
    if not KIND.match(kind or ""):
        raise ValueError("--kind is the wall it hit, like github-write or relay")
    if kind in PIECE_KINDS and not acting_for:
        raise PermissionError(f"a {kind} approval is filed by the piece on loom's machine for its body (--as), not by a body")
    target = exact_target(target)
    if kind == "merge" and not repo_of(target):
        raise ValueError("a merge target is literal: <forge>:<owner>/<repo>#<n>@<40-hex head>, letters, digits, . _ - only")
    if kind == GRANT_KIND and not grant_of(target):
        raise ValueError("a grant target is <piece>:<agent>, or <piece>:<agent>:<path>,<path> for only those paths "
                         "(a path, or a prefix ending in /*): tasks:mark")
    if kind == VOUCH_KIND and not vouch_of(target):
        raise ValueError(f"a vouch-wake target is <agent>:<w-id>[,<w-id>…], 1 to {VOUCH_MAX} wake ids, sorted, each once")
    if kind == RESET_KIND and not reset_of(target):
        raise ValueError("a principal-reset target is <agent>:<cv-id>")
    if kind in (VOUCH_KIND, RESET_KIND) and (vouch_of(target) or reset_of(target))["agent"] != who["agent"]:
        # Filed for the agent whose wakes or conversation it names: its owner reads whose they are from the card.
        raise PermissionError(f"a {kind} approval names the agent it's filed for ({who['agent']})")
    if kind in (VOUCH_KIND, RESET_KIND) and p["for"] != OWNER:
        # The owner's own decision about whose work this is: filed (and spent) on his behalf, so the card's words are true.
        raise ValueError(f"a {kind} approval is filed --on-behalf owner")
    if kind in (VOUCH_KIND, RESET_KIND):
        # The owner reads exactly what his Allow does: each wake (its note and when it fires) or the conversation (its
        # label), resolved by the piece that files it. A card without them, or one that leaves a wake out, is refused.
        d = str(details or "")
        if not d.strip() or not ask:
            raise ValueError(f"a {kind} card lists what it covers (--details, with --ask): each wake, or the conversation")
        lines = d.splitlines()
        if kind == VOUCH_KIND and not all(any(i in ln and "fires" in ln for ln in lines) for i in vouch_of(target)["ids"]):
            raise ValueError("a vouch-wake card's --details lists every wake on it: a line each, with its id and when it fires")
        if kind == RESET_KIND and reset_of(target)["conversation"] not in d:
            raise ValueError("a principal-reset card's --details names the conversation: its label and its id")
    # Shown whole or not at all: words that don't fit on the card (after normalizing, as shown)
    # are refused, never cut, so nothing can hide past the part the owner reads.
    for label, text, n in (("--target", target, TARGET_MAX), ("--what", what, WORDS_MAX), ("--why", why, WORDS_MAX)):
        if len(plain(text, 10**6)) > n:
            raise ValueError(f"{label} is {n} characters at most as shown on the card; say it shorter")
    words = {}
    if ask:
        # The plain ask (the card's headline), with what happens either way: checked like a task's ask.
        words = {"ask": unicodedata.normalize("NFKC", str(ask)).strip(), "why": unicodedata.normalize("NFKC", str(why or "")).strip(),
                 "if_yes": unicodedata.normalize("NFKC", str(if_yes or "")).strip(), "if_no": unicodedata.normalize("NFKC", str(if_no or "")).strip()}
        check_plain(words)
        words = {k: plain(v, 10**6) for k, v in words.items()}
        # Checked as shown: words that are only markup or control characters leave nothing to read.
        if not all(words[k] for k in ("ask", "why", "if_yes", "if_no")):
            raise ValueError("with --ask, say --why, --if-yes and --if-no too, in words: the owner reads what happens either way beside Allow and Deny")
        if details:
            d = unicodedata.normalize("NFKC", str(details)).replace("\r", "")
            if len(d) > DETAILS_MAX:
                raise ValueError(f"--details is {DETAILS_MAX} characters at most")
            words["details"] = "".join(c for c in d if c == "\n" or unicodedata.category(c)[0] != "C").strip()
        what = plain(what, WORDS_MAX) or words["ask"]
        why = words["why"]
    else:
        what, why = plain(what, WORDS_MAX), plain(why, WORDS_MAX)
    if not target or not what or not why:
        raise ValueError("say exactly what (--target), the plain question (--ask, with --why, --if-yes and --if-no) "
                         "and why: the owner reads them to decide")
    mins = DEFAULT_MIN if not minutes else max(1, min(int(minutes), MAX_MIN))
    with Store() as s:
        if kind in (VOUCH_KIND, RESET_KIND):
            # Never asked again after a No, and never two cards waiting for the same wake or conversation: this store is
            # the durable record of his answer, whatever the filing piece remembers (t-1975).
            mine = covered({"kind": kind, "target": target})
            for a in s.d["approvals"].values():
                if a["kind"] != kind or a["who"].get("agent") != who["agent"] or a["target"] == target and state_of(a) in ("pending", "allowed"):
                    # The same card again (waiting, or allowed and not yet applied): answered below, as any kind's is.
                    continue
                both = sorted(mine & covered(a))
                if both and a["state"] == "denied":
                    raise PermissionError(f"the owner said no for {' '.join(both)} already ({a['id']}): not asked again")
                if both and state_of(a) == "pending":
                    raise PermissionError(f"{a['id']} already asks about {' '.join(both)}: withdraw it first (withdraw {a['id']})")
                if both and state_of(a) == "allowed":
                    raise PermissionError(f"the owner allowed {a['id']} for {' '.join(both)}: apply it (it's spent by the piece) before asking again")
        # Asking again for the same thing is the same card, from any of the agent's bodies (use's rule): a parked body's
        # continuation asks from a later house, and a second card would ask the owner twice for one thing.
        last = newest_decision(s.d["approvals"].values(), kind, target, who["agent"])
        for a in s.d["approvals"].values():
            if a["kind"] == kind and a["target"] == target and may_spend(a["who"], who) and same_principal(a, p) \
                    and state_of(a) in ("pending", "allowed"):
                # A caller that now says it plainly: a pending card takes the plain words (the owner hasn't read it yet).
                # Only the body the card names, so the words the owner reads are the ones its "from" says.
                if words and state_of(a) == "pending" and not a.get("ask") and a["who"] == who:
                    a.update({k: v for k, v in words.items() if k in ("ask", "if_yes", "if_no", "details") and v}, why=why)
                    s.save()
                # Older/local callers could omit the display link. A later continuation repairs that
                # same pending card instead of making a duplicate or moving an existing thread's card.
                if conversation and not a.get("conversation") and state_of(a) == "pending":
                    a["conversation"] = conversation
                    s.save()
                # An allowed one counts only if the owner hasn't said no to this exact thing since.
                if state_of(a) == "allowed" and last and last["state"] == "denied" and last["decided"] > a.get("decided", ""):
                    continue
                return a
        # The owner answered this exact target already (approvals grant): that's the answer, newest first.
        granted = sorted((a for a in s.d["approvals"].values() if a.get("granted") and a["kind"] == kind
                          and a["target"] == target and a["who"].get("agent") == who["agent"] and same_principal(a, p)
                          and state_of(a) in ("allowed", "denied")), key=lambda a: a["at"], reverse=True)
        if granted:
            return {**granted[0], "state": state_of(granted[0])}
        a = {"id": "a-" + secrets.token_hex(4), "kind": kind, "target": target, "what": what, "why": why,
             **{k: v for k, v in words.items() if k in ("ask", "if_yes", "if_no", "details") and v},
             # Kept with the agent loom authenticated: the pair is what a thread checks (see request's note).
             **({"conversation": conversation} if conversation else {}),
             "who": who, "for": p["for"], **({"people": p["people"]} if p["people"] else {}),
             "minutes": mins, "at": iso(now()), "state": "pending"}
        s.d["approvals"][a["id"]] = a
        s.save()
        s.log("request", a, what=what, why=why)
        return a


def get(aid):
    with Store() as s:
        a = s.d["approvals"].get(aid)
        if not a:
            raise LookupError(f"no approval {aid}")
        return {**a, "state": state_of(a)}


def spend_card(caller, aid):
    """What a parked body's continuation needs to spend its own approval without asking again: its state, and the
    exact kind and target `use` takes, as filed. Only for the agent that asked (spender): another agent gets its state
    from plain check, never what it's for. Reading spends nothing and widens nothing; use still checks all of it."""
    who = who_of(caller)
    a = get(aid)
    if not may_spend(a["who"], who):
        raise PermissionError(f"{aid} isn't {who['agent']}'s to read here; check {aid} gives its state")
    return {"id": a["id"], "agent": a["who"].get("agent"), "for": for_of(a), "state": a["state"], "kind": a["kind"], "target": a["target"],
            "expires": a.get("expires") if a["state"] == "allowed" else None,
            **({"decidedBy": a["by"]} if a.get("by") else {})}


def use(caller, aid, kind, target, acting_for=False, statement=None, on_behalf=None, unstated=False):
    """Spend an allowed approval for exactly the action it allowed, for the one it was asked for. True once.
    `unstated`: a piece on loom's machine spending for a body (--as) without saying on whose behalf (--on-behalf): the
    runtime's relay, which has no conversation to ask about. Everything else is checked; whom it was for isn't."""
    if (kind in PIECE_KINDS or kind in PIECE_SPENT) and not acting_for:
        # Spent by the piece that runs it (the clock sets the wake, the runtime applies a grant), never by a body: a
        # body's own `use` would spend the owner's yes and run nothing.
        raise PermissionError(f"a {kind} approval is spent by the piece on loom's machine that runs it, not by a body")
    who = who_of(caller)
    target = exact_target(target)
    p = principal_for_call(caller, who, statement, acting_for, on_behalf)
    with Store() as s:
        a = s.d["approvals"].get(aid)
        if not a:
            raise LookupError(f"no approval {aid}")
        # Who first, and saying nothing of what it's for or where it was asked: an id alone tells nobody else its
        # kind or target. The agent that asked spends it from any of its own bodies (may_spend).
        if not may_spend(a["who"], who):
            s.log("refused-use", a, who_used=who)
            raise PermissionError(f"{aid} isn't {who['agent']}'s to spend from here")
        st = state_of(a)
        if st != "allowed":
            raise PermissionError(f"{aid} is {st}" + (", waiting on the owner" if st == "pending" else ""))
        if a["kind"] != kind or a["target"] != target:
            s.log("refused-use", a, kind_used=kind, target_used=target)
            raise PermissionError(f"{aid} allows {a['kind']} for {a['target']}, not {kind} for {target}")
        # For the one it was asked for, and nobody else (t-1943): the owner's yes for Loren isn't a yes for Dan, or for
        # the owner's own work, and his yes for himself isn't one for Loren.
        if not unstated and not same_principal(a, p):
            s.log("refused-use", a, for_used=p["for"])
            raise PermissionError(f"{aid} was asked for {for_words(a) or 'the owner'}; this body acts for {principal_words(p)}")
        if kind in (VOUCH_KIND, RESET_KIND):
            # A newer No for any wake (or the conversation) it covers overrules it: nothing he said no to is applied.
            no = [b for b in s.d["approvals"].values() if b["id"] != aid and b["kind"] == kind and b["state"] == "denied"
                  and b["who"].get("agent") == a["who"].get("agent") and b.get("decided", "") > a.get("decided", "")
                  and covered(b) & covered(a)]
            if no:
                s.log("refused-use", a, denied_by=no[0]["id"])
                raise PermissionError(f"{aid} was overruled: the owner said no to some of it after ({no[0]['id']})")
        last = newest_decision(s.d["approvals"].values(), kind, target, a["who"].get("agent"))
        if last and last["id"] != aid and last["state"] == "denied" and last["decided"] > a.get("decided", ""):
            s.log("refused-use", a, denied_by=last["id"])
            raise PermissionError(f"{aid} was overruled: the owner said no to {target} after ({last['id']})")
        a["state"], a["used"] = "used", iso(now())
        s.save()
        s.log("use", a)
        return a


def withdraw(caller, aid):
    """A piece's own pending card taken back, unanswered (t-1975): the clock refreshing its one card of unknown wakes
    with an up-to-date list, so the owner never has two for one batch. Only a kind a piece files (PIECE_KINDS), only
    from loom's machine for the agent it was filed for (--as), and only while pending: an answer stands."""
    who = who_of(caller)
    with Store() as s:
        a = s.d["approvals"].get(aid)
        if not a:
            raise LookupError(f"no approval {aid}")
        if a["kind"] not in PIECE_KINDS or a["who"].get("agent") != who["agent"]:
            raise PermissionError(f"{aid} isn't one {who['agent']}'s piece filed")
        if state_of(a) != "pending":
            raise PermissionError(f"{aid} is {state_of(a)}: an answer stands")
        a["state"], a["withdrawn"] = "withdrawn", iso(now())
        s.save()
        s.log("withdraw", a)
        return a


def answer(aid, action, by=None, minutes=None):
    """by: the household member who answered (loom's caller, loom docs/specs/owners.md), when loom says."""
    with Store() as s:
        a = s.d["approvals"].get(aid)
        if not a:
            raise LookupError("no such approval")
        if state_of(a) != "pending":
            raise PermissionError(f"it's already {state_of(a)}")
        t = now()
        a["state"] = "allowed" if action == "allow" else "denied"
        a["decided"] = iso(t)
        if by:
            a["by"] = by
        if action == "allow":
            a["expires"] = iso(datetime.fromtimestamp(t.timestamp() + (minutes or a["minutes"]) * 60, timezone.utc))
        else:
            deny_siblings(s, a["kind"], a["target"], a["who"].get("agent"), a["id"], by)
        s.save()
        s.log(action, a)
        return a


def covered(a):
    """The wakes (or the conversation) a vouch-wake (or principal-reset) approval covers; empty for any other."""
    if a.get("kind") == VOUCH_KIND and vouch_of(a.get("target")):
        return set(vouch_of(a["target"])["ids"])
    if a.get("kind") == RESET_KIND and reset_of(a.get("target")):
        return {reset_of(a["target"])["conversation"]}
    return set()


def recent():
    with Store() as s:
        return sorted(({**a, "state": state_of(a)} for a in s.d["approvals"].values()), key=lambda a: a["at"], reverse=True)


# ---------------------------------------------------------------- plain words (taskstore's lint, src/plain.ts)

# The same rules taskstore applies to a task's title and ask (sleepunit-agents/taskstore src/plain.ts, spec
# taskstore-core it_ts-plain), so an approval's card reads as plainly as a task's: the ask is a headline (no ids of
# any kind); why and the if-lines may name a pull request or a task, never an internal id, a hash or lane words.
PLAIN_LIMITS = {"ask": 140, "why": 240, "if_yes": 200, "if_no": 200}
PLAIN_STRICT = {"ask"}
PLAIN_FLAG = {"ask": "--ask", "why": "--why", "if_yes": "--if-yes", "if_no": "--if-no"}
PLAIN_RULES = [
    ("a task id", re.compile(r"\bt-\d+\b"), True),
    ("a pull request or issue id", re.compile(r"(?<![\w./-])(?:[\w.-]+/)?[\w.-]+#\d+\b"), True),
    ("an internal id", re.compile(r"\b(?:a-[0-9a-f]{8}|cv-[0-9a-f]{6,}|dg-[0-9a-f]{6,}|w-[0-9a-f]{6,}|r-\d{3,}|h-\d+)\b", re.I), False),
    ("a hex id", re.compile(r"(?<![\w-])(?=[0-9a-f]*\d)(?=[0-9a-f]*[a-f])[0-9a-f]{6,40}\b", re.I), False),
    # Past taskstore's rule: a hash longer than a commit's (a sha256) is an id too.
    ("a hex id", re.compile(r"(?<![\w-])[0-9a-f]{41,}\b", re.I), False),
    ("a round number", re.compile(r"\bround\s+\d+\b", re.I), False),
    ("a lane or wake word", re.compile(r"\b(?:nudge[- ]watch|chain[- ]check|local[- ]wake|plan[- ]night|wake (?:in|at|park|relay|list))\b", re.I), False),
    ("a raw site or unit code", re.compile(r"\b[A-Z]{1,2}\d{2,4}\b"), False),
]
PLAIN_TAG = re.compile(r"^([\w.-]+):\s")


def plain_findings(field, value):
    """What in `value` a person can't read, as (what, text) pairs: taskstore's lintField, rule for rule."""
    out, seen = [], set()

    def add(what, text):
        if text not in seen:
            seen.add(text)
            out.append((what, text))
    strict = field in PLAIN_STRICT
    if strict:
        m = PLAIN_TAG.match(value)
        if m:
            add("a leading tag", m.group(1) + ":")
    for what, rx, strict_only in PLAIN_RULES:
        if strict_only and not strict:
            continue
        for m in rx.finditer(value):
            add(what, m.group(0))
    if len(value) > PLAIN_LIMITS[field]:
        add(f"over {PLAIN_LIMITS[field]} characters", f"{len(value)} characters")
    if re.search(r"[\r\n]", value):
        add("more than one line", "a line break")
    return out


PLAIN_EXAMPLE = ('approvals request --kind gh-guard --target "…" \\\n'
                 '  --ask "A change to Art\'s sync script landed. OK to start updating lane prompts on loom again?" \\\n'
                 '  --why "The script that copies lane prompts to loom changed, so it stopped until you look." \\\n'
                 '  --if-yes "Lane prompt changes go live again." --if-no "Lane prompts stay as they are until you look."')


def check_plain(fields):
    """Refuse an ask that doesn't read plainly, saying exactly what and how to say it instead."""
    bad = [f"{PLAIN_FLAG[f]} can't have {json.dumps(t)} ({w})" for f in ("ask", "why", "if_yes", "if_no")
           if fields.get(f) for w, t in plain_findings(f, fields[f])]
    if bad:
        raise ValueError("the card is what the owner reads to decide, so it says it in plain words (ids and the "
                         "exact target go in --target and --details): " + "; ".join(bad) + ". For example:\n" + PLAIN_EXAMPLE)


# ---------------------------------------------------------------- standing rules

def seed_rules():
    try:
        rows = json.loads(setting("APPROVALS_SEED_RULES", "[]"))
    except ValueError:
        return []
    out = []
    for r in rows if isinstance(rows, list) else []:
        if not isinstance(r, dict):
            continue
        try:
            rule = make_rule(r.get("kind", "merge"), r.get("scope"), r.get("tier"), "seed")
        except ValueError:
            continue
        out = [x for x in out if not (x["kind"] == rule["kind"] and x["scope"] == rule["scope"])] + [rule]
    return out[:RULES_MAX]


PROJECT_SCOPE = re.compile(r"project:[a-z0-9]+(?:-[a-z0-9]+)*")
STRICT = {"ask": 0, "tell": 1, "do": 2}      # strictest first


def well_formed(r):
    return isinstance(r, dict) and r.get("kind") in RULE_KINDS and r.get("tier") in TIERS \
        and isinstance(r.get("scope"), str) and valid_scope(r["scope"])


def well_formed_grant(g):
    """A grant (t-1943): the owner's standing answer for one other person, a rule with a person."""
    return well_formed(g) and isinstance(g.get("person"), str) and PERSON.fullmatch(g["person"]) is not None


def make_grant(person, kind, scope, tier, by):
    person = str(person or "").strip().lower()
    if not PERSON.fullmatch(person) or len(person) > 80:
        raise ValueError("a grant names a person by their slug, like loren or loren-smith")
    if person == OWNER:
        raise ValueError("owner is the word for your own work (your rules above), not a person to grant")
    return {"person": person, **make_rule(kind, scope, tier, by)}


def with_grant(grants, person, kind, scope, tier, by):
    """The grants with (person, kind, scope) set to tier, or removed for tier none."""
    g = make_grant(person, kind, scope, "ask" if tier == "none" else tier, by)
    rest = [x for x in grants if not (x["person"] == g["person"] and x["kind"] == kind and x["scope"] == g["scope"])]
    if tier == "none":
        return rest, g
    if len(rest) >= GRANTS_MAX:
        raise ValueError(f"{GRANTS_MAX} grants at most")
    return rest + [g], g


def set_grant(person, kind, scope, tier, by):
    """The owner's edit, on the page: a grant for one person; tier none removes it."""
    with Store() as s:
        grants, g = with_grant(s.grants(), person, kind, scope, tier, by)
        s.replace_rules(list(s.rules()), grants)
        return g


def valid_scope(scope):
    """project:<slug>, exactly; or <forge>:<pattern>, where forge is never "project" (that's a project's)."""
    if scope.startswith("project:"):
        return PROJECT_SCOPE.fullmatch(scope) is not None
    return re.fullmatch(rf"{FORGE}:{LOCATOR}", scope) is not None


def make_rule(kind, scope, tier, by):
    if kind not in RULE_KINDS:
        raise ValueError(f"only {', '.join(RULE_KINDS)} has standing rules")
    scope = str(scope or "").strip()
    if ":" in scope and not scope.startswith("project:"):
        forge, _, loc = scope.partition(":")
        scope = f"{forge}:{loc.lower()}"
    if not valid_scope(scope):
        raise ValueError("a scope is a repo pattern like github:acme/* or github:acme/app, or a project like project:pond")
    if tier not in TIERS:
        raise ValueError("a tier is do (just do it), tell (tell me after) or ask (ask me)")
    return {"kind": kind, "scope": scope, "tier": tier, "by": by or "owner", "at": iso(now())}


def repo_of(target):
    """A merge target's repo id (github:acme/app), its change number and head, or None."""
    m = MERGE_TARGET.fullmatch(str(target or ""))
    if not m or len(m.group(2)) > LOCATOR_MAX:
        return None
    return {"repo": f"{m.group(1)}:{m.group(2).lower()}", "forge": m.group(1), "locator": m.group(2).lower(),
            "number": int(m.group(3)), "head": m.group(4)}


def norm_repo(sel):
    """A project card's repo selector as a repo id: a bare owner/repo is github's (loom docs/specs/projects.md)."""
    sel = str(sel or "").strip()
    if not re.match(rf"^{FORGE}:", sel):
        sel = "github:" + sel
    forge, _, loc = sel.partition(":")
    return f"{forge}:{loc.lower()}"


def projects():
    """The live project cards as [{slug, name, repos}], in loom's order; None when they can't be read."""
    cmd = setting("APPROVALS_PROJECTS", "loom project list --json")
    try:
        out = subprocess.run(shlex.split(cmd), capture_output=True, text=True, timeout=2, stdin=subprocess.DEVNULL)
        rows = json.loads(out.stdout) if out.returncode == 0 else None
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    if not isinstance(rows, list):
        return None
    return [{"slug": r.get("slug"), "name": r.get("name") or r.get("slug"),
             "repos": [norm_repo(x) for x in ((r.get("links") or {}).get("repos") or []) if isinstance(x, str)]}
            for r in rows if isinstance(r, dict) and isinstance(r.get("slug"), str)]


def glob_match(pattern, text):
    """* is any characters but / within one segment; everything else is itself."""
    rx = "".join("[^/]*" if c == "*" else re.escape(c) for c in pattern)
    return re.fullmatch(rx, text) is not None


def resolve(rules, kind, target, cards=None):
    """Which rule applies to TARGET, and its tier: (tier, rule or None, note). Most specific wins: an exact repo,
    then a project, then a pattern with fewer *; at a tie the stricter tier. No rule: ask."""
    r = repo_of(target)
    if not r:
        raise ValueError("a merge target is <forge>:<locator>#<n>@<40-hex head>, like github:acme/app#12@…")
    hits = []
    # Failing closed: with a project rule for this kind and no project list to read, nothing can say this repo isn't
    # in that project. Only an exact-repo rule (more specific than any project) still stands; otherwise it asks.
    blind = cards is None and any(x.get("kind") == kind and x.get("scope", "").startswith("project:") for x in rules)
    for rule in rules:
        if rule.get("kind") != kind:
            continue
        scope = rule.get("scope", "")
        if scope.startswith("project:"):
            if cards is None:
                continue
            slug = scope[len("project:"):]
            if any(c["slug"] == slug and r["repo"] in c["repos"] for c in cards):
                hits.append(((1, 0), rule))
        else:
            forge, _, pat = scope.partition(":")
            if forge == r["forge"] and glob_match(pat.lower(), r["locator"]):
                stars = pat.count("*")
                hits.append(((0, 0) if stars == 0 else (2, stars), rule))
    if blind and not any(h[0] == (0, 0) for h in hits):
        return "ask", None, "the project list couldn't be read, so this asks (a project rule might apply to this repo)"
    if not hits:
        return "ask", None, None
    hits.sort(key=lambda h: (h[0], STRICT[h[1]["tier"]]))
    return hits[0][1]["tier"], hits[0][1], None


def needs_cards(rules):
    return any(r.get("scope", "").startswith("project:") for r in rules)


UNKNOWN_NOTE = "this body acts for someone loom can't name (no word from the runtime, or several people), so it asks"


def rules_for(agent, kind, targets, principal=OWNER, people=()):
    """Each target's tier and, for ask, the newest merge approval for it, this agent and this principal:
    {target: {tier, approval?}}. The standing rules are the owner's own work's (t-1943); for anyone else, the grants the
    owner set for that person; for someone loom can't name, ask."""
    if kind not in RULE_KINDS:
        raise ValueError(f"only {', '.join(RULE_KINDS)} has standing rules")
    with Store() as s:
        rules = list(s.rules())
        if principal != OWNER:
            rules = [g for g in s.grants() if g["person"] == principal]
        rows = [a for a in s.d["approvals"].values() if a["kind"] == kind and a["who"].get("agent") == agent
                and same_principal(a, {"for": principal, "people": people})]
    cards = projects() if needs_cards(rules) else []
    out = {}
    for t in targets:
        if principal == UNKNOWN:
            if not repo_of(t):
                raise ValueError("a merge target is <forge>:<locator>#<n>@<40-hex head>, like github:acme/app#12@…")
            tier, rule, note = "ask", None, UNKNOWN_NOTE
        else:
            tier, rule, note = resolve(rules, kind, t, cards)
        mine = sorted((a for a in rows if a["target"] == t), key=lambda a: a["at"], reverse=True)
        out[t] = {"tier": tier, "for": principal, **({"scope": rule["scope"]} if rule else {}), **({"note": note} if note else {}),
                  **({"approval": {"id": mine[0]["id"], "state": state_of(mine[0])}} if mine else {})}
    return out


def rule_answer(caller, kind, targets, agent=None, as_json=False, statement=None):
    """`rule merge TARGET…`: for the asking agent, or (loom's machine only) --for another agent, as the owner's own
    work (the Changes piece shows the owner his own rules). On whose behalf decides which rules: rules_for."""
    if agent and caller:
        raise PermissionError("--for is for loom's machine (the Changes piece), not over the API")
    if not 1 <= len(targets) <= 200:
        raise ValueError("rule merge TARGET [TARGET…], 200 at most")
    who = {"agent": agent} if agent else who_of(caller)
    # --for (loom's machine): the Changes piece's view, as any call here is: the statement if there is one, else
    # APPROVALS_LOCAL_PRINCIPAL; a local body is never the owner for being here.
    p = principal_for_call(caller, who, statement)
    res = rules_for(who["agent"], kind, targets, p["for"], p.get("people") or ())
    if as_json:
        return json.dumps(res) + "\n", ""
    out = []
    for t in targets:
        r = res[t]
        line = r["tier"] + (f" {r['approval']['state']} {r['approval']['id']}" if r["tier"] == "ask" and "approval" in r else "")
        out.append(line + ("" if len(targets) == 1 else f"  {t}"))
    notes = {r["note"] for r in res.values() if "note" in r}
    return "\n".join(out) + "\n", "".join(f"approvals: {n}\n" for n in notes)


def with_rule(rules, kind, scope, tier, by):
    """The rules with the (kind, scope) rule set to tier, or removed for tier none. Validates the scope."""
    rule = make_rule(kind, scope, "ask" if tier == "none" else tier, by)
    rest = [r for r in rules if not (r["kind"] == kind and r["scope"] == rule["scope"])]
    if tier == "none":
        return rest, rule
    if len(rest) >= RULES_MAX:
        raise ValueError(f"{RULES_MAX} rules at most")
    return rest + [rule], rule


def set_rule(kind, scope, tier, by):
    """The owner's edit: tier none removes the scope's rule."""
    with Store() as s:
        rules, rule = with_rule(s.rules(), kind, scope, tier, by)
        s.replace_rules(rules)
        return rule


def always(aid, by, cards):
    """Always for <project or repo> on a pending merge approval: the rule set to do and the approval allowed, under
    one lock, so neither happens without the other."""
    with Store() as s:
        a = s.d["approvals"].get(aid)
        if not a:
            raise LookupError("no such approval")
        if state_of(a) != "pending":
            raise PermissionError(f"it's already {state_of(a)}")
        al = always_scope(a, cards)
        if not al:
            raise ValueError("Always is for a merge of one repo, for you or for one person")
        f = for_of(a)
        # For the owner's own work, his standing rule; for one other person, his grant for them (t-1943).
        if f == OWNER:
            rules, grants = with_rule(s.rules(), "merge", al[0], "do", by)[0], None
        else:
            rules, grants = list(s.rules()), with_grant(s.grants(), f, "merge", al[0], "do", by)[0]
        t = now()
        a["state"], a["decided"] = "allowed", iso(t)
        if by:
            a["by"] = by
        a["expires"] = iso(datetime.fromtimestamp(t.timestamp() + a["minutes"] * 60, timezone.utc))
        s.replace_rules(rules, grants)
        s.save()
        s.log("allow", a, always=al[0], **({"for": f} if f != OWNER else {}))
        return a, al


def grant(kind, target, agent, by, deny=False, person=OWNER):
    """The owner's answer from loom's machine (the Changes piece's Yes and Not yet): answers the agent's pending
    request for TARGET, or makes the answer for one it hasn't made yet. For the owner's own work unless --person names
    whom it's for (t-1943): a yes for himself is never one for someone else."""
    raw, person = person, OWNER if person == OWNER else str(person or "").strip().lower()
    if raw != OWNER and person == OWNER:
        raise ValueError("--person owner is the owner's own work: leave --person out")
    if person != OWNER and not (PERSON.fullmatch(person) and len(person) <= 80):
        raise ValueError("--person is the slug of whom it's for")
    if kind != "merge" or not repo_of(target):
        raise ValueError("grant is for a merge approval: --kind merge --target <forge>:<locator>#<n>@<head>")
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,39}", agent or ""):
        raise ValueError("--for is the agent whose change it is")
    with Store() as s:
        pending = sorted((a for a in s.d["approvals"].values() if a["kind"] == kind and a["target"] == target
                          and a["who"].get("agent") == agent and for_of(a) == person and state_of(a) == "pending"),
                         key=lambda a: a["at"])
    if pending:
        return answer(pending[-1]["id"], "deny" if deny else "allow", by, minutes=GRANT_MIN)
    with Store() as s:
        t = now()
        a = {"id": "a-" + secrets.token_hex(4), "kind": kind, "target": target,
             "what": f"merge {target.split('@')[0]}", "why": "the owner said " + ("not yet" if deny else "yes, merge it"),
             "who": {"agent": agent, "where": "any"}, "for": person, "granted": True, "minutes": GRANT_MIN, "at": iso(t),
             "state": "denied" if deny else "allowed", "decided": iso(t)}
        if by:
            a["by"] = by
        if not deny:
            a["expires"] = iso(datetime.fromtimestamp(t.timestamp() + GRANT_MIN * 60, timezone.utc))
        else:
            deny_siblings(s, kind, target, agent, a["id"], by)
        s.d["approvals"][a["id"]] = a
        s.save()
        s.log("grant" if not deny else "grant-deny", a)
        return a


def tell(caller, kind, target, what, statement=None):
    """After merging under a do or tell rule (or grant): an FYI for the owner (the manifest's notices)."""
    who = who_of(caller)
    p = principal_for_call(caller, who, statement)
    if len(plain(what, 10**6)) > WORDS_MAX:
        raise ValueError(f"--what is {WORDS_MAX} characters at most as shown; say it shorter")
    what = plain(what, WORDS_MAX)
    if not what:
        raise ValueError("--what says what was merged, for the owner")
    r = rules_for(who["agent"], kind, [target], p["for"], p.get("people") or ())[target]
    tier, note = r["tier"], r.get("note")
    if tier == "ask":
        raise PermissionError(f"{note}: request a merge approval instead" if note else
                              f"the rule for {target.split('@')[0]} is ask me: request a merge approval instead")
    with Store() as s:
        n = {"at": iso(now()), "agent": who["agent"], "kind": kind, "target": target, "what": what,
             **({"for": p["for"]} if p["for"] != OWNER else {})}
        s.d.setdefault("notices", []).insert(0, n)
        s.d["notices"] = s.d["notices"][:NOTICES_KEEP]
        s.save()
        return n


# ---------------------------------------------------------------- loom's page

OUTCOME = {"allowed": "Allowed, not used yet.", "used": "Allowed, and used.", "denied": "Denied.", "expired": "Allowed, but it expired unused.",
           "withdrawn": "Withdrawn unanswered: asked again with an up-to-date list."}

# The page says what an approval is for in plain words, not ids.
STATE_WORDS = {"pending": "Waiting on you", "allowed": "Allowed", "used": "Used", "denied": "Denied", "expired": "Expired",
               "withdrawn": "Withdrawn"}
# The kinds the clock piece files, plus any the instance names (APPROVALS_KINDS).
KIND_WORDS = {"local-wake": "A wake on loom's machine", "relay": "A message to another agent", "merge": "A merge",
              "grant": "Access to a piece", "vouch-wake": "Scheduled jobs counted as yours",
              "principal-reset": "A conversation counted as yours", "box-administration": "Scoped work on a box"}
try:
    _extra = json.loads(setting("APPROVALS_KINDS", "{}"))
    KIND_WORDS.update({k: v for k, v in _extra.items() if KIND.match(str(k)) and isinstance(v, str)} if isinstance(_extra, dict) else {})
except ValueError:
    pass


def name_of(agent):
    return agent[:1].upper() + agent[1:] if agent else "An agent"


def what_of(a):
    """What it asks for. A wake on loom's machine was filed as "run on loom's machine: …"; the card's meta already says
    that ("A wake on loom's machine"), so the row says only what the wake would do."""
    what = a.get("what", "")
    head = "run on loom's machine: "
    if a.get("kind") == "local-wake" and what.startswith(head):
        what = what[len(head):]
        if not re.match(r"[a-z]-\d", what):   # an id that leads stays as it's written (a task's, say)
            what = what[:1].upper() + what[1:]
    return what


def place_of(who):
    """Where it asked from, in words: "Ada's chat house", "loom's machine", "a body"."""
    where = who.get("where", "")
    m = re.search(r"\(([^()]*)\)$", where)
    service = m.group(1).replace("-", " ").capitalize() if m else None
    if re.match(r"h-[0-9]+\b", where):
        return f"{name_of(who.get('agent'))}'s {service.lower() if service else ''} house".replace("  ", " ")
    return where or "an agent's body"


def meta_of(a):
    """What it is, where it was asked from, and why: "A wake on loom's machine · from Ada's chat house, for any of
    Ada's bodies · “…”". A target that's only a key for loom (a wake's agent:hash) is left out; a real one (a repo) stays."""
    kind = KIND_WORDS.get(a["kind"], a["kind"].replace("-", " ").capitalize())
    # Only a wake's target is an internal key (agent:hash); every other kind's target is shown, whatever it looks like.
    target = None if a["kind"] == "local-wake" and re.fullmatch(r"[a-z][a-z0-9-]*:[0-9a-f]{8,}", a["target"] or "") else a["target"]
    return " · ".join(x for x in (kind + (f": {target}" if target else ""), from_of(a), f"“{a['why']}”") if x)


def notices():
    with Store() as s:
        return list(s.d.get("notices") or [])


def notice_of(n):
    tgt = n.get("target", "")
    r = repo_of(tgt)
    change = f"{r['locator']}#{r['number']}" if r else tgt.split("@")[0]
    whose = f" for {person_name(n['for'])}" if n.get("for") and n["for"] != OWNER else ""
    return {"text": f"{name_of(n.get('agent'))} merged {change}{whose}", "meta": n.get("what") or "under a tell me after rule",
            "at": n["at"], "agent": n.get("agent"), "page": ""}


NO_ASK = "(no plain question given)"


def body_ask(a):
    """The body's own question: the plain ask, whole; an old-style request reads as itself, marked, so it gets fixed."""
    return a["ask"] if a.get("ask") else f"{NO_ASK} {cap(what_of(a))}"


def headline(a):
    """The card's headline. For the owner's own work, the body's plain ask. For anyone else's (t-1943) it says whose,
    first: a merge as "Merge on-pond#220 for Loren?", anything else as "For Loren: <the ask>". The words are the
    piece's, never the body's: the body can't make a card for Loren read as the owner's."""
    if owner_words(a):
        # What Allow gives, from the target it applies: the body's words are the detail under it, never the headline.
        return owner_words(a)
    fw = for_words(a)
    if not fw:
        return body_ask(a)
    r = repo_of(a.get("target")) if a.get("kind") == "merge" else None
    if r:
        return f"Merge {r['locator'].split('/')[-1]}#{r['number']} for {fw}?"
    return f"For {fw}: {body_ask(a)}"


def ask_detail(a):
    """What the sheet says under the headline when the headline isn't the body's own ask (a merge for someone else)."""
    return body_ask(a) if headline(a) != body_ask(a) and not headline(a).endswith(body_ask(a)) else None


def fine_print(a):
    """Exactly what Allow allows: the kind and target (machine fields), where it was asked from, for whom, for how long."""
    if a.get("kind") == GRANT_KIND and grant_of(a.get("target")):
        g = grant_of(a["target"])
        # Short whatever the target (loom refuses a card's fine print past 400, and with it every card): the paths are
        # the headline's, said once there.
        return (f"Access to a piece, {from_of(a)}. Allowing it adds that to whatever {name_of(g['agent'])} has in "
                f"{name_of(g['piece'])} already (nothing is taken away): the runtime applies it at once, as you, and it stays "
                "until you change it on Permissions.")[:FINE_MAX]
    if a.get("kind") == VOUCH_KIND and vouch_of(a.get("target")):
        v = vouch_of(a["target"])
        # The ids are listed whole in the details above (each with when it fires): never cut here, so not here at all.
        return (f"Scheduled jobs counted as yours, {from_of(a)}. Allowing it counts exactly the {len(v['ids'])} listed "
                "above, by id, as your work: loom's clock applies it at once, as you.")[:FINE_MAX]
    if a.get("kind") == RESET_KIND and reset_of(a.get("target")):
        r = reset_of(a["target"])
        return (f"A conversation counted as yours, {from_of(a)}. Allowing it makes {r['conversation']} your work from "
                "now on: the runtime applies it at once, as you, setting aside what it heard before and its session.")[:FINE_MAX]
    fw = for_words(a)
    named = a.get("people") or []
    everyone = f" ({', '.join(person_name(p) for p in named)})" if len(named) > 3 else ""
    whose = f" It's for {fw}{everyone}, not for you: it's spent only for {fw}." if fw else ""
    return f"{kind_of(a)}, {from_of(a)}.{whose} Allowing it lets that one action through once, within {a['minutes']} min."


def ui_manifest():
    rows = recent()
    pending = [a for a in rows if a["state"] == "pending"][:10]
    # loom's Inbox: what's waiting is a permission; what was answered is its history (Answered).
    done = [a for a in rows if a["state"] in OUTCOME][:20]
    # The tab makes the page real: without it loom serves no /p/approvals, and the asks' and answered rows' links led
    # nowhere. Visited rarely, so it sits under Setup.
    return {"v": 2, "tab": {"label": "Approvals", "kind": "setting", "icon": "stamp"}, "asks": [{
        "text": headline(a),
        "meta": a["why"] if a.get("ask") else meta_of(a),
        # The structured ask (loom's Inbox and Home show these whole, Allow beside "If you allow", Deny beside "If you
        # deny"); fine is the small print under "Exactly what this allows".
        **({"why": a["why"], "if_yes": a["if_yes"], "if_no": a["if_no"]} if a.get("ask") else {}),
        # A grant's "If you allow" is the piece's, from its target: what Allow gives is never the body's to describe.
        # ...and it leads: wherever loom's Inbox absorbs it into the agent's Needs you, these words head it, not the agent's.
        **({**owner_lines(a), "lead": True} if owner_lines(a) else {}),
        **({"details": "\n\n".join(x for x in (ask_detail(a), a.get("details")) if x)} if ask_detail(a) or a.get("details") else {}),
        **({"for": for_of(a)} if for_of(a) != OWNER else {}),
        "fine": fine_print(a),
        "tone": "warn", "at": a["at"], "agent": a["who"]["agent"], "page": "", "kind": "permission",
        **({"conversation": a["conversation"]} if a.get("conversation") else {}),
        "actions": [{"action": "allow", "label": allow_label(a), "tone": "primary", "fields": {"id": a["id"]}},
                    {"action": "deny", "label": "Deny", "tone": "danger", "fields": {"id": a["id"]}}],
    } for a in pending], "answered": [{
        "text": (headline(a) if a.get("ask") or for_words(a) or a["kind"] in OWNER_APPLIED else f"{name_of(a['who']['agent'])} asked: {what_of(a)}")[:300],
        "outcome": OUTCOME[a["state"]] + (f" ({'Allowed' if a['state'] != 'denied' else 'Denied'} by {a['by']}.)" if a.get("by") else ""),
        "at": a.get("used") or a.get("decided") or a["at"], "kind": "permission", "agent": a["who"]["agent"], "page": "",
    } for a in done], "notices": [notice_of(n) for n in notices()[:20]]}


def ago(stamp, t=None):
    """How long ago, in words: "just now", "5 min ago", "3 hours ago", "yesterday", "4 days ago", else the date."""
    try:
        d = datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except (TypeError, ValueError):
        return ""
    s = max(0, ((t or now()) - d).total_seconds())
    if s < 60:
        return "just now"
    if s < 3600:
        return f"{int(s // 60)} min ago"
    if s < 86400:
        h = int(s // 3600)
        return f"{h} hour{'' if h == 1 else 's'} ago"
    days = int(s // 86400)
    if days == 1:
        return "yesterday"
    if days < 7:
        return f"{days} days ago"
    return "on " + d.astimezone().strftime("%b %-d")


def cap(text):
    """A body's words as a sentence on the page: its first letter capital, unless an id leads (t-12: …)."""
    return text if re.match(r"[a-z]-\d", text) else text[:1].upper() + text[1:]


def member(by):
    """A household member's slug as a name: "jonathan-barket" -> "Jonathan Barket"."""
    return " ".join(w[:1].upper() + w[1:] for w in str(by).split("-") if w)


def kind_of(a):
    """The wall it hit and exactly what for, in words; a wake's internal key is left out (meta_of)."""
    kind = KIND_WORDS.get(a["kind"], a["kind"].replace("-", " ").capitalize())
    target = None if a["kind"] == "local-wake" and re.fullmatch(r"[a-z][a-z0-9-]*:[0-9a-f]{8,}", a["target"] or "") else a["target"]
    return kind + (f": {target}" if target else "")


def from_of(a):
    """Where it was asked from, and who may spend it: any of the agent's bodies (spender)."""
    name = name_of(a['who'].get('agent'))
    svc = service_of(a["who"])
    bodies = f"for any of {name}'s own bodies" + (f" or its {svc.replace('-', ' ')} houses" if svc else "")
    return bodies if a["who"].get("where") == "any" else f"from {place_of(a['who'])}, {bodies}"


def always_scope(a, cards):
    """For a pending merge approval: the scope Always would set, and its words. The project that names the repo
    (the first, in loom's order), else the exact repo."""
    r = repo_of(a.get("target"))
    if a.get("kind") != "merge" or not r or PATTERN_CHARS & set(r["repo"]):
        return None        # never a pattern from a body's target: refused, not escaped
    f = for_of(a)
    if f == UNKNOWN:
        return None        # nobody to grant it to: someone loom can't name gets no standing yes
    # For someone else, Always is a grant for that person (t-1943), and says so.
    lead = "Always" if f == OWNER else f"Always for {person_name(f)} on"
    for c in cards or []:
        if r["repo"] in c["repos"]:
            return f"project:{c['slug']}", (f"Always for {c['name']}" if f == OWNER else f"{lead} {c['name']}")
    return r["repo"], (f"Always for {r['locator']}" if f == OWNER else f"{lead} {r['locator']}")


def allow_label(a):
    """Allow once, for a single action; one the owner's Allow applies (a grant, a vouch, a reset) says only Allow."""
    return "Allow" if a.get("kind") in OWNER_APPLIED else "Allow once"


def answers_of(a, cards=None):
    items = [{"action": "allow", "label": allow_label(a), "tone": "primary", "fields": {"id": a["id"]}}]
    al = always_scope(a, cards) if cards is not None else None
    if al:
        items.append({"action": "always", "label": al[1], "fields": {"id": a["id"]}})
    return items + [{"action": "deny", "label": "Deny", "tone": "danger", "fields": {"id": a["id"]}}]


def outcome_of(a):
    """How it went and who decided, in words: "Allowed by Jonathan Barket, and used"."""
    by = f" by {member(a['by'])}" if a.get("by") else ""
    return {"used": f"Allowed{by}, and used", "allowed": f"Allowed{by}, not used yet",
            "expired": f"Allowed{by}, expired unused", "denied": f"Denied{by}",
            "withdrawn": "Withdrawn unanswered: asked again with an up-to-date list"}.get(a["state"], a["state"].capitalize())


def past_meta(a):
    """What it would have done, how it went, when, and why: wrapped on the page, nothing cut."""
    when = ago(a.get("used") or a.get("decided") or a.get("withdrawn") or a["at"])
    return " · ".join(x for x in (what_of(a), f"{outcome_of(a)} {when}".strip(), f"“{a['why']}”") if x)


RECORD_MAX = 1900   # loom refuses a block's text over 2000 characters, and with it the whole page


def record_text(rows):
    """The record's lines, newest first, as many as fit in one code block; then how many older ones there are."""
    out, used = [], 0
    for n, a in enumerate(rows):
        line = f"{a['id']}  {a['state']}  {a['kind']}  {a['target']}  {a['who'].get('agent')}@{a['who'].get('where')}  for {for_of(a)}"
        if used + len(line) + 1 > RECORD_MAX - 60:
            out.append(f"… and {len(rows) - n} older (approvals list, on loom's machine)")
            break
        out.append(line)
        used += len(line) + 1
    return "\n".join(out)


def ui_page(req):
    if (req or {}).get("path", "") != "":
        return {"title": "Not found", "sections": []}
    rows = recent()
    pending = [a for a in rows if a["state"] == "pending"]
    past = [a for a in rows if a["state"] != "pending"][:60]
    owner = is_owner(req)
    if owner:
        with Store() as s:
            proj_rules = any(r["scope"].startswith("project:") for r in [*s.rules(), *s.grants()])
    cards = projects() if owner and (proj_rules or any(a["kind"] == "merge" for a in pending)) else None
    sections = []
    if pending:
        # Each waiting approval: what it would do, and why, in words; Allow once and Deny in its sheet.
        sections.append({"id": "waiting", "title": "Waiting on you", "tone": "warn", "blocks": [{"type": "panel", "rows": [{
            "label": headline(a), "agent": a["who"]["agent"], "tone": "warn",
            "value": a["why"], "detail": f"{name_of(a['who']['agent'])} · {ago(a['at'])}",
            "sheet": {"title": f"{name_of(a['who']['agent'])} asks", "blocks": [
                {"type": "text", "text": headline(a)},
                *([{"type": "text", "text": ask_detail(a)}] if ask_detail(a) else []),
                {"type": "text", "text": a["why"]},
                *([{"type": "kv", "items": [{"label": "If you allow", "value": {**a, **owner_lines(a)}["if_yes"]},
                                            {"label": "If you deny", "value": {**a, **owner_lines(a)}["if_no"]}]}]
                  if a.get("if_yes") or owner_lines(a) else []),
                {"type": "buttons", "items": answers_of(a, cards if owner else None)},
                *([{"type": "text", "text": a["details"]}] if a.get("details") else []),
                # A sheet is already folded detail: loom refuses a details block inside one, and with it the page.
                {"type": "text", "tone": "muted", "text": f"Exactly what this allows: {fine_print(a)}"},
            ]},
        } for a in pending[:20]]}]})
    else:
        sections.append({"id": "waiting", "blocks": [{"type": "health", "tone": "ok", "text": "Nothing waiting on you",
                                                      "detail": "When a body asks for an approval, it shows here and on Home."}]})
    if owner:
        sections.append(rules_section(cards))
    if past:
        sections.append({"id": "answered", "title": "Answered", "blocks": [{"type": "list", "wrap": True, "items": [{
            "text": headline(a) if a.get("ask") or for_words(a) or a["kind"] in OWNER_APPLIED else f"{name_of(a['who']['agent'])} · {kind_of(a)}", "agent": a["who"]["agent"], "meta": past_meta(a),
            "tone": {"denied": "bad", "expired": "muted", "withdrawn": "muted"}.get(a["state"]),
        } for a in past]}]})
    if rows:
        sections.append({"id": "record", "blocks": [{"type": "panel", "rows": [{
            "label": "The record", "value": "Each approval's id, kind and exact target",
            "sheet": {"title": "The record", "blocks": [{"type": "code", "label": "id  state  kind  target  asked from  for",
                "text": record_text(rows)}]},
        }]}]})
    return {"title": "Approvals",
            "intro": "A body that hits a permission wall asks; you allow it once. It's spent by the one action it names.",
            "sections": sections}


TIER_WORDS = {"do": "Just do it", "tell": "Tell me after", "ask": "Ask me"}
TIER_DETAIL = {"do": "Merges once CI is green and review is clean, without asking",
               "tell": "Merges once it's green, then tells you", "ask": "Asks you for each merge, one commit at a time"}


def scope_words(scope, cards):
    """A rule's scope as people say it: "The pond project", "Everything in onterris", "acme/app", "acme/app-*"."""
    if scope.startswith("project:"):
        slug = scope[len("project:"):]
        name = next((c["name"] for c in cards or [] if c["slug"] == slug), slug)
        return f"The {name} project"
    forge, _, pat = scope.partition(":")
    where = "" if forge == "github" else f" on {forge.capitalize()}"
    m = re.fullmatch(r"([^/*]+)/\*", pat)
    return (f"Everything in {m.group(1)}" if m else pat) + where


def rules_section(cards):
    with Store() as s:
        rules = list(s.rules())
    rows = [{
        "label": scope_words(r["scope"], cards), "value": TIER_WORDS[r["tier"]], "detail": TIER_DETAIL[r["tier"]],
        "tone": "warn" if r["tier"] == "ask" else None,
        "choice": {"action": "rule", "name": "tier", "value": r["tier"], "fields": {"scope": r["scope"], "kind": r["kind"]},
                   "options": [{"value": t, "label": TIER_WORDS[t]} for t in TIERS] + [{"value": "none", "label": "No rule"}]},
    } for r in sorted(rules, key=lambda r: (STRICT[r["tier"]], r["scope"]))]
    for row in rows:
        if row["tone"] is None:
            del row["tone"]
    rows.append({"label": "Add a rule", "value": "For a repo, a pattern of repos, or a project",
                 "edit": {"action": "rule-add", "title": "Add a rule", "submit": "Add the rule",
                          "note": "A repo (github:acme/app), a pattern (github:acme/*) or a project (project:pond). "
                                  "The most specific rule wins; with none, a merge asks you.",
                          "fields": [{"name": "scope", "label": "For", "kind": "text", "required": True,
                                      "hint": "github:acme/* or project:pond"},
                                     {"name": "tier", "label": "Then", "kind": "segmented", "value": "ask",
                                      "options": [{"value": t, "label": TIER_WORDS[t]} for t in TIERS]}]}})
    blocks = [{"type": "panel", "title": "Merging, for you", "rows": rows}, grants_panel(cards)]
    return {"id": "rules", "title": "Standing rules", "fold": "open", "blocks": blocks}


def grants_panel(cards):
    """The owner's grants for other people (t-1943), beside his own rules: work an agent does on someone else's
    behalf never reads his rules, only what he granted that person here; with nothing granted, it asks him."""
    with Store() as s:
        grants = list(s.grants())
    rows = [{
        "label": f"{person_name(g['person'])}: {scope_words(g['scope'], cards)}", "value": TIER_WORDS[g["tier"]],
        "detail": TIER_DETAIL[g["tier"]] + f", when the work is for {person_name(g['person'])}",
        **({"tone": "warn"} if g["tier"] == "ask" else {}),
        "choice": {"action": "grant", "name": "tier", "value": g["tier"],
                   "fields": {"person": g["person"], "scope": g["scope"], "kind": g["kind"]},
                   "options": [{"value": t, "label": TIER_WORDS[t]} for t in TIERS] + [{"value": "none", "label": "No grant"}]},
    } for g in sorted(grants, key=lambda g: (g["person"], STRICT[g["tier"]], g["scope"]))]
    rows.append({"label": "Add a grant for someone", "value": "Merges an agent does for another person",
                 "edit": {"action": "grant-add", "title": "Add a grant for someone", "submit": "Add the grant",
                          "note": "Your rules above are for work done for you. Work an agent does for someone else "
                                  "(a person in Slack or Discord) asks you, unless you grant that person something here.",
                          "fields": [{"name": "person", "label": "Who", "kind": "text", "required": True,
                                      "hint": "their slug, like loren"},
                                     {"name": "scope", "label": "For", "kind": "text", "required": True,
                                      "hint": "github:onterris/on-pond or project:pond"},
                                     {"name": "tier", "label": "Then", "kind": "segmented", "value": "ask",
                                      "options": [{"value": t, "label": TIER_WORDS[t]} for t in TIERS]}]}})
    return {"type": "panel", "title": "Merging, for other people", "rows": rows}


def is_owner(req):
    """The household's owner (every agent's): rules are theirs alone."""
    c = (req or {}).get("caller")
    # Fails closed, by loom's own rule for an owner (src/ui/pieces.ts, withGrant): kind owner, agents absent or "*".
    # No caller (a loom without a household, a run by hand) is not the owner: rules and Always are refused.
    return isinstance(c, dict) and c.get("kind") == "owner" and c.get("agents") in (None, "*")


def caller_who(req):
    """The member acting on loom's page (its caller, in a household), if it names one cleanly."""
    c = (req or {}).get("caller") or {}
    who = c.get("who") if isinstance(c, dict) and c.get("kind") == "owner" else None
    return who if isinstance(who, str) and re.fullmatch(r"[a-z0-9]+(-[a-z0-9]+)*", who) else None


def ui_act(req):
    action = (req or {}).get("action")
    f = (req or {}).get("fields") or {}
    if action in ("rule", "rule-add"):
        if not is_owner(req):
            return {"ok": False, "message": "Standing rules are the household owner's.", "page": ""}
        try:
            r = set_rule(f.get("kind") or "merge", f.get("scope"), f.get("tier"), caller_who(req))
        except ValueError as e:
            return {"ok": False, "message": str(e), "page": ""}
        words = scope_words(r["scope"], projects() if r["scope"].startswith("project:") else [])
        return {"ok": True, "message": f"{words}: " + ("no rule now, so it asks" if f.get("tier") == "none" else TIER_WORDS[r["tier"]].lower()), "page": ""}
    if action in ("grant", "grant-add"):
        # The owner's grants for other people (t-1943): his alone, on this page, never through the API.
        if not is_owner(req):
            return {"ok": False, "message": "Grants for other people are the household owner's.", "page": ""}
        try:
            g = set_grant(f.get("person"), f.get("kind") or "merge", f.get("scope"), f.get("tier"), caller_who(req))
        except ValueError as e:
            return {"ok": False, "message": str(e), "page": ""}
        words = scope_words(g["scope"], projects() if g["scope"].startswith("project:") else [])
        return {"ok": True, "message": f"For {person_name(g['person'])}, {words}: "
                + ("no grant now, so it asks" if f.get("tier") == "none" else TIER_WORDS[g["tier"]].lower()), "page": ""}
    aid = f.get("id", "")
    if action == "always":
        if not is_owner(req):
            return {"ok": False, "message": "Standing rules are the household owner's.", "page": ""}
        if not ID.match(str(aid)):
            return {"ok": False, "message": "That isn't an approval.", "page": ""}
        cards = projects()
        try:
            _, al = always(aid, caller_who(req), cards)
        except (LookupError, PermissionError, ValueError) as e:
            return {"ok": False, "message": str(e), "page": ""}
        a = get(aid)
        whose = "" if for_of(a) == OWNER else f" for {person_name(for_of(a))}"
        return {"ok": True, "message": f"Allowed, and from now on{whose}: {scope_words(al[0], cards)}, just do it.", "page": ""}
    if action not in ("allow", "deny") or not ID.match(str(aid)):
        return {"ok": False, "message": "That isn't an approval.", "page": ""}
    try:
        k = get(aid)["kind"]
        if k in OWNER_APPLIED and not is_owner(req):
            # The household's pieces are its owner's to give (t-1970), and whose work a wake or a conversation is, his to
            # say (t-1975): an agent's owner answers its other asks, not these.
            return {"ok": False, "message": "Access to a piece is the household owner's to give or refuse." if k == GRANT_KIND
                    else "Only the household owner says whose work this is.", "page": ""}
        a = answer(aid, action, caller_who(req))
    except (LookupError, PermissionError) as e:
        return {"ok": False, "message": str(e), "page": ""}
    if a["kind"] in OWNER_APPLIED:
        # loom applies an allowed one through the piece that owns it right after this answer, and says so itself.
        return {"ok": True, "message": f"{'Allowed' if action == 'allow' else 'Denied'}: {headline(a).rstrip('?')}.", "page": ""}
    return {"ok": True, "message": f"{'Allowed once' if action == 'allow' else 'Denied'}: {a['what']}"
            + (f" (for {a['minutes']} min)" if action == "allow" else ""), "page": ""}


# ---------------------------------------------------------------- the piece API

STATE_MAX = 50


def states(ids):
    """What loom's core reads to clear a Needs you that waits on an approval (loom docs/specs/conversations.md): each
    known id's state and whose it is. No words: core shows the card's own (ui --json) while it waits."""
    with Store() as s:
        rows = s.d["approvals"]
        # An owner-applied one's target too: an identifier (<piece>:<agent>, <agent>:<w-ids>, <agent>:<cv>), which core
        # hands the piece that spends and applies it.
        return {i: {"state": state_of(rows[i]), "agent": rows[i]["who"].get("agent"), "kind": rows[i]["kind"],
                    **({"target": rows[i]["target"]} if rows[i]["kind"] in OWNER_APPLIED else {})}
                for i in ids if i in rows}


def api_answer(req):
    def refuse(status, error):
        return {"status": status, "body": {"error": error}}
    if isinstance(req, dict) and req.get("path") == "state":
        # The owner's read (core, for the household): which of these approvals are still pending. Reading is all;
        # answering stays on the page (ui act), and a body never reads another's here.
        if (req.get("caller") or {}).get("kind") != "owner":
            return refuse(403, "state is the owner's read; a body checks its own with run check")
        ids = (req.get("body") or {}).get("ids")
        if not isinstance(ids, list) or not 1 <= len(ids) <= STATE_MAX or not all(isinstance(i, str) and ID.match(i) for i in ids):
            return refuse(400, f"ids: 1 to {STATE_MAX} approval ids (a- and 8 hex digits)")
        return {"status": 200, "body": {"approvals": states(ids)}}
    if not isinstance(req, dict) or req.get("path") != "run":
        return refuse(404, "the calls are run (a body's) and state (the owner's)")
    caller = req.get("caller") or {}
    if caller.get("kind") != "agent":
        return refuse(403, "only an agent's bodies ask here; the owner answers on the page")
    argv = (req.get("body") or {}).get("argv")
    if not isinstance(argv, list) or not 1 <= len(argv) <= 26 or not all(isinstance(a, str) and len(a) <= 1100 for a in argv):
        return refuse(400, "argv: request --kind K --target T --what W --why Y | check ID [--json] | use ID --kind K --target T"
                           " | rule merge TARGET | tell --kind merge --target TARGET --what W")
    try:
        out = run(argv, caller)
        out, err = out if isinstance(out, tuple) else (out, "")
        return {"status": 200, "body": {"exit": 0, "stdout": out, "stderr": err}}
    except (ValueError, LookupError, PermissionError) as e:
        return {"status": 200, "body": {"exit": 1, "stdout": "", "stderr": f"approvals: {e}\n"}}


def take_principal(argv):
    """argv without `--principal <statement>` (a house's piece-call adds it: the runtime's word on whom the body acts
    for), and the statement: the last one, if any."""
    out, st, i = [], None, 0
    while i < len(argv):
        if argv[i] == "--principal" and i + 1 < len(argv):
            st, i = argv[i + 1], i + 2
            continue
        if argv[i].startswith("--principal="):
            st, i = argv[i].split("=", 1)[1], i + 1
            continue
        out.append(argv[i])
        i += 1
    return out, (st or None)


def run(argv, caller=None):
    argv, statement = take_principal(list(argv))
    ap = argparse.ArgumentParser(prog="approvals", add_help=False, exit_on_error=False)
    sub = ap.add_subparsers(dest="cmd")
    r = sub.add_parser("request", add_help=False, exit_on_error=False)
    for f in ("--kind", "--target", "--what", "--why", "--minutes", "--ask", "--details", "--conversation"):
        r.add_argument(f, default="")
    r.add_argument("--if-yes", dest="if_yes", default="")
    r.add_argument("--if-no", dest="if_no", default="")
    r.add_argument("--as", dest="as_", default="")
    r.add_argument("--on-behalf", dest="on_behalf", default="")
    c = sub.add_parser("check", add_help=False, exit_on_error=False)
    c.add_argument("id")
    c.add_argument("--json", action="store_true")
    c.add_argument("--as", dest="as_", default="")
    u = sub.add_parser("use", add_help=False, exit_on_error=False)
    u.add_argument("id")
    u.add_argument("--kind", default="")
    u.add_argument("--target", default="")
    u.add_argument("--as", dest="as_", default="")
    u.add_argument("--on-behalf", dest="on_behalf", default="")
    w = sub.add_parser("withdraw", add_help=False, exit_on_error=False)
    w.add_argument("id")
    w.add_argument("--as", dest="as_", default="")
    sub.add_parser("list", add_help=False, exit_on_error=False)
    ru = sub.add_parser("rule", add_help=False, exit_on_error=False)
    ru.add_argument("kind")
    ru.add_argument("targets", nargs="+")
    ru.add_argument("--for", dest="for_", default="")
    ru.add_argument("--json", action="store_true")
    t = sub.add_parser("tell", add_help=False, exit_on_error=False)
    for fl in ("--kind", "--target", "--what"):
        t.add_argument(fl, default="")
    g = sub.add_parser("grant", add_help=False, exit_on_error=False)
    for fl in ("--kind", "--target", "--by"):
        g.add_argument(fl, default="")
    g.add_argument("--for", dest="for_", default="")
    g.add_argument("--person", default="")
    g.add_argument("--deny", action="store_true")
    try:
        a = ap.parse_args(argv)
    except (argparse.ArgumentError, SystemExit) as e:
        raise ValueError(f"usage: {e}") from None
    if getattr(a, "on_behalf", "") and not a.as_:
        raise PermissionError("--on-behalf is for a piece on loom's machine acting for a body (--as)")
    body_here = bool(os.environ.get("LOOM_BODY_CONVERSATION") or os.environ.get("LOOM_BODY_KEY"))
    piece_kind = a.cmd in ("request", "use") and a.kind in (VOUCH_KIND, RESET_KIND, "box-administration")
    if body_here and ((a.cmd == "use" and a.kind in OWNER_APPLIED) or piece_kind or a.cmd == "withdraw"):
        # Filed, withdrawn and spent only by the piece that owns it, never from a body the runtime runs on loom's machine
        # as the runtime starts it (LOOM_BODY_CONVERSATION and LOOM_BODY_KEY, its run's key, are in every such body's
        # environment; either one refuses). A body that unsets them is past what any piece here can check: loom's machine
        # is the trust boundary (its bodies share the owner's account and have the host's own escapes; in_a_house,
        # below). Houses and the API are refused outright (--as only from loom's machine).
        raise PermissionError(f"a {getattr(a, 'kind', '') or 'piece'}'s card is the piece's to {a.cmd}, not a body's")
    if a.cmd == "use" and a.kind in (VOUCH_KIND, RESET_KIND, "box-administration") and not a.as_ and not caller:
        # Spent by the piece that applies it, for the agent it was filed for: always said (--as and --on-behalf).
        raise PermissionError(f"a {a.kind} approval is spent by the piece that applies it (--as the agent, --on-behalf owner)")
    if a.cmd == "withdraw":
        # A piece on loom's machine only, for the body it filed for: never a body over the API.
        if caller or not a.as_:
            raise PermissionError("withdraw is for the piece on loom's machine that filed it (--as)")
    if a.cmd in ("request", "use", "check", "withdraw") and a.as_:
        # A piece on loom's machine acting for a body (the clock filing or spending a house's
        # approval) names it with --as; only a local call may say so.
        if caller:
            raise PermissionError("--as is for a piece on loom's machine acting for a body, not over the API")
        try:
            caller = json.loads(a.as_)
        except ValueError:
            raise ValueError("--as is the caller's JSON") from None
    if a.cmd == "request":
        x = request(caller, a.kind, a.target, a.what, a.why, int(a.minutes) if a.minutes.isdigit() else None,
                    acting_for=bool(a.as_), ask=a.ask or None, if_yes=a.if_yes or None, if_no=a.if_no or None,
                    details=a.details or None, conversation=a.conversation or None, statement=statement,
                    on_behalf=a.on_behalf or None)
        if x["state"] == "denied":
            return f"{x['id']}: the owner said not yet for this exact change and head; a new push asks again\n"
        if x["state"] == "allowed" and x["kind"] == GRANT_KIND:
            # Applied by loom at the owner's Allow; one still allowed wasn't (loom told the owner why, at the Allow).
            return f"{x['id']}: the owner allowed it, but it wasn't applied; ask the owner to give it on Permissions\n"
        if x["state"] == "allowed" and x["kind"] in OWNER_APPLIED:
            return f"{x['id']}: the owner allowed it; the piece that filed it applies it (use it there: --kind {x['kind']})\n"
        if x["state"] == "allowed":
            return f"{x['id']}: already allowed (until {x['expires']}); use it: approvals use {x['id']} --kind {x['kind']} --target '{x['target']}'\n"
        return f"{x['id']}: asked the owner (a card on loom's Home); check it: approvals check {x['id']}\n"
    if a.cmd == "withdraw":
        return f"{withdraw(caller, a.id)['id']}: withdrawn\n"
    if a.cmd == "check":
        if a.json:
            return json.dumps(spend_card(caller, a.id)) + "\n"
        return get(a.id)["state"] + "\n"
    if a.cmd == "use":
        # Over the API (a body) only with no wake kind; on loom's machine (the clock, with or without --as) any.
        use(caller, a.id, a.kind, a.target, acting_for=bool(a.as_) or not caller, statement=statement, on_behalf=a.on_behalf or None,
            # Only the runtime may leave whom unsaid (t-1953): its relay, and a grant it applies (the owner's own decision
            # about an agent, whoever the body asked for); any other kind a piece spends says it, or is held to unknown.
            unstated=bool(a.as_) and not a.on_behalf and a.kind in ("relay", GRANT_KIND))
        return f"{a.id}: used\n"
    if a.cmd == "rule":
        return rule_answer(caller, a.kind, a.targets, a.for_ or None, a.json, statement=statement)
    if a.cmd == "tell":
        if a.kind not in RULE_KINDS or not repo_of(a.target):
            raise ValueError("tell --kind merge --target <forge>:<locator>#<n>@<head> --what \"…\"")
        n = tell(caller, a.kind, a.target, a.what, statement=statement)
        return f"told the owner: {notice_of(n)['text']}\n"
    if a.cmd == "grant":
        # The owner's answer, from loom's machine only (the Changes piece's Yes and Not yet): never a body's.
        if caller:
            raise PermissionError("grant is the owner's, on loom's machine; a body asks with request")
        if a.by and not re.fullmatch(r"[a-z0-9]+(-[a-z0-9]+)*", a.by):
            raise ValueError("--by is a household member's slug")
        # No --person: the owner's own work. --person owner is a person by that name, refused (never the owner).
        x = grant(a.kind, a.target, a.for_, a.by or None, a.deny, person=OWNER if a.person == "" else (a.person if a.person != OWNER else " owner"))
        return f"{x['id']}: {x['state']}\n"
    if a.cmd == "list":
        if caller:
            raise PermissionError("the list is the owner's, on loom's machine")
        return "".join(f"{x['id']} {x['state']:<8} {x['kind']} {x['target']} — {x['who']['agent']}: {x['what']}\n" for x in recent()[:30])
    raise ValueError("request | check | use | withdraw | list | rule | tell | grant")


# ---------------------------------------------------------------- in a house

def in_a_house():
    """A house is known by what a body can't change (podman's /run/.containerenv, a bind mount),
    not HOUSE_ID alone, which a body can unset: there it never keeps a store or answers as the piece."""
    return os.path.exists("/run/.containerenv") or bool(os.environ.get("HOUSE_ID"))


def forward(piece, argv):
    """Run this command as loom's piece instead, through loom's piece API (POST /api/<piece>/run) as this
    body's own token: LOOM_URL (the /mcp URL is fine) and LOOM_TOKEN_FILE (in a loom-box house,
    /run/secrets/loom-token by default). Prints what the piece printed and exits with its code."""
    url, tokfile = os.environ.get("LOOM_URL"), os.environ.get("LOOM_TOKEN_FILE")
    if not tokfile and os.path.exists("/run/secrets/loom-token"):
        tokfile = "/run/secrets/loom-token"
    if not url or not tokfile:
        sys.exit(f"{piece}: in a house this runs through loom's piece API: set LOOM_URL and LOOM_TOKEN_FILE")
    base = url.rstrip("/").removesuffix("/mcp")
    with open(tokfile) as f:
        token = f.read().strip()
    req = urllib.request.Request(f"{base}/api/{piece}/run", data=json.dumps({"argv": argv}).encode(), method="POST",
                                 headers={"content-type": "application/json", "authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            body = json.load(r)
    except urllib.error.HTTPError as e:
        try:
            why = json.load(e).get("error")
        except ValueError:
            why = None
        sys.exit(f"{piece}: loom refused {argv[0] if argv else 'the call'}: {why or f'{e.code} {e.reason}'}")
    except (urllib.error.URLError, OSError, ValueError) as e:
        sys.exit(f"{piece}: couldn't reach loom at {base}: {e}")
    sys.stdout.write(body.get("stdout") or "")
    sys.stderr.write(body.get("stderr") or "")
    code = body.get("exit")
    sys.exit(code if isinstance(code, int) else 1)


def main():
    args = sys.argv[1:]
    # Local and house bodies carry the same conversation provenance. It is a display link,
    # never authority: the verified principal still decides what the request may do.
    conv = os.environ.get("LOOM_BODY_CONVERSATION", "")
    if args[:1] == ["request"] and "--conversation" not in args and CONVERSATION.fullmatch(conv):
        args = [*args, "--conversation", conv]
    # In a house the store isn't here: it's loom's machine's, through the piece API, as the
    # house's own token (like the clock). On loom's machine the user account is the boundary:
    # its bodies have the host's own escapes anyway; approvals bind houses.
    if in_a_house():
        if args[:1] in (["ui"], ["api"]):
            sys.exit("approvals: the piece runs on loom's machine, not in a house")
        # On whose behalf (t-1943): the runtime's statement, as piece-call adds it; a typed one is dropped.
        args, typed = take_principal(args)
        st = (fetch_statement(conv) if CONVERSATION.fullmatch(conv) and args else None) or typed
        forward("approvals", args + (["--principal", st] if st else []))
    if args[:1] == ["ui"]:
        rest = [a for a in args[1:] if a != "--json"]
        if not rest:
            print(json.dumps(ui_manifest()))
        elif rest == ["page"]:
            print(json.dumps(ui_page(json.loads(sys.stdin.read() or "{}"))))
        elif rest == ["act"]:
            print(json.dumps(ui_act(json.loads(sys.stdin.read() or "{}"))))
        else:
            sys.exit(2)
        return
    if args[:1] == ["api"]:
        try:
            req = json.loads(sys.stdin.read())
        except ValueError:
            req = None
        print(json.dumps(api_answer(req)))
        return
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    conv = os.environ.get("LOOM_BODY_CONVERSATION", "")
    if CONVERSATION.fullmatch(conv) and "--as" not in args:
        global LOCAL_BODY
        LOCAL_BODY = True
        args, _ = take_principal(args)
        st = fetch_statement(conv)
        args = args + (["--principal", st] if st else [])
    try:
        out = run(args)
        out, err = out if isinstance(out, tuple) else (out, "")
        sys.stdout.write(out)
        sys.stderr.write(err)
    except (ValueError, LookupError, PermissionError) as e:
        sys.exit(f"approvals: {e}")


if __name__ == "__main__":
    main()
